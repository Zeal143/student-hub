# Copy this file to .env and fill in real values. Never commit .env.

# MySQL (matches AWS RDS or local MySQL)
DB_USER=root
DB_PASSWORD=changeme
DB_HOST=localhost
DB_PORT=3306
DB_NAME=student_hub

# Flask / JWT
SECRET_KEY=replace-with-a-long-random-string
JWT_SECRET_KEY=replace-with-a-different-long-random-string
JWT_ACCESS_TOKEN_EXPIRES_HOURS=12

# Gmail SMTP for bin collection reminder emails
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=youraddress@gmail.com
SMTP_PASSWORD=your-16-char-app-password
SMTP_FROM_NAME=Irish International Student Hub
